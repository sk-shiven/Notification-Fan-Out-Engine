# ==============================================================================
# Notification Fan-Out Engine - Environment Configuration
# ==============================================================================

# Application & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Database (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/notification_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Apache Kafka Broker
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_FANOUT=fanout-workers
KAFKA_CONSUMER_GROUP_WEBHOOK=webhook-delivery-workers
KAFKA_CONSUMER_GROUP_EMAIL=email-delivery-workers

# Kafka Topics
TOPIC_EVENTS_RAW=events.raw
TOPIC_DELIVERIES_WEBHOOK=deliveries.webhook
TOPIC_DELIVERIES_EMAIL=deliveries.email
TOPIC_DELIVERIES_DLQ=deliveries.dlq
TOPIC_DELIVERIES_PARKED=deliveries.parked

# Kafka Connect / Debezium
KAFKA_CONNECT_URL=http://localhost:8083
DEBEZIUM_CONNECTOR_NAME=notification-outbox-connector

# Redis (Distributed Rate Limiting & Parked Keys)
REDIS_URL=redis://localhost:6379/0

# Ingestion API
API_HOST=0.0.0.0
API_PORT=8000

# Webhook Dispatcher
WEBHOOK_CONNECT_TIMEOUT_SEC=5.0
WEBHOOK_READ_TIMEOUT_SEC=10.0
WEBHOOK_MAX_RETRIES=5

# SMTP / Email Channel (Development MailHog / Mock Sink)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SENDER=notifications@engine.local
